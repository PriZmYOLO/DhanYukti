# --- Anumati Account Aggregator (via Perfios FIU gateway) ---
ANUMATI_BASE_URL=
ANUMATI_CLIENT_ID=
ANUMATI_CLIENT_SECRET=
ANUMATI_FIU_ID=
ANUMATI_CALLBACK_URL=
ANUMATI_REDIRECT_URL=

# --- Perfios ---
# Hub (bills, ration, EPF, vehicle, licence, IRDAI agent) needs only these three: portal username,
# portal password, client id. Never commit real values.
PERFIOS_SECURE_ID=
PERFIOS_SECURE_CREDENTIAL=
PERFIOS_ORG_ID=
# Optional; default is the test environment https://hub-test.perfios.ai/ssp/kyc/api
PERFIOS_HUB_BASE_URL=
# Analytics/BSA (paths unverified; leave empty to keep them on replay)
PERFIOS_BASE_URL=

# --- Optional: Claude rephrasing for /api/ask (numbers are always computed by rules) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANUMATI_SPEC_VERSION=2.0.0

# --- Team-only demo reset (POST /api/admin/reset needs X-Admin-Token). Unset = reset refused. ---
ADMIN_RESET_TOKEN=
