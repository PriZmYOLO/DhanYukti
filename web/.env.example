# Server-only unless prefixed NEXT_PUBLIC_. Names only here; never commit real values.

# FastAPI engines (Render). Every /api/* path the Next app doesn't handle itself is proxied here.
# Local default: http://127.0.0.1:8000
API_ORIGIN=

# Live Anumati AA (FIU module). Webhooks are registered for dhan-yukti.vercel.app,
# so live AA only works when this app is deployed on that domain.
# ANUMATI_BASE_URL is the FIU module base URL (UAT: https://fiu-module-uat.anumati.co.in).
# ANUMATI_KEY_ESCROW: true or false. NEXT_PUBLIC_AA_LIVE: true for the live adapter, false for the demo.
ANUMATI_BASE_URL=
ANUMATI_CLIENT_ID=
ANUMATI_CLIENT_SECRET=
ANUMATI_KEY_ESCROW=
NEXT_PUBLIC_AA_LIVE=

# Shared storage for AA links, DPDP Value Ledger, cover profile, onboarding answers,
# invites and reports (Upstash Redis via Vercel Marketplace). Local dev uses memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bhashini (Hindi voice). Without these, Hindi read-outs fall back to the phone's voice and say so.
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=
